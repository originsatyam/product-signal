{
  "name": "product-signal",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n \"FRONTEND,BACKEND\" -c \"blue.bold,magenta.bold\" \"npm run dev-frontend\" \"npm run dev-backend\"",
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
